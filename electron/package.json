{
  "name": "audiovault",
  "version": "1.0.0",
  "description": "Audiovault desktop shell",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.audiovault.app",
    "productName": "Audiovault",
    "directories": {
      "output": "../dist-electron"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "../frontend/dist/**"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  }
}
